# ========================================================
# IMDb Clone - Environment Variables Template
# ========================================================

# Application Port
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imdb_clone
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Express Session Secret Key
SESSION_SECRET=your_super_secret_session_key_here

# SendGrid API Key for Password Reset Emails
SENDGRID_API=SG.your_sendgrid_api_key_here

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

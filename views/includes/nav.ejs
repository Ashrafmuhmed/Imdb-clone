<nav class="navbar">
    <div class="nav-container">
        <div class="nav-logo">
            <a href="/">IMDB Clone</a>
        </div>

        <div class="nav-search">
            <form action="/search" method="GET" class="nav-search-form">
                <input type="text" name="q" placeholder="Search movies, shows, people..." class="nav-search-input" value="<%= typeof query !== 'undefined' ? query : '' %>">
                <button type="submit" class="nav-search-btn">🔍</button>
            </form>
        </div>

        <div class="nav-links">
            <a href="/titles" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'titles' ? 'active' : '' %>">Movies & TV</a>
            <a href="/names" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'names' ? 'active' : '' %>">People</a>
            <a href="/search/advanced" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'advanced-search' ? 'active' : '' %>">Advanced Search</a>
            <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                <a href="/watchlist" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'watchlist' ? 'active' : '' %>">Watchlist</a>
                <div class="nav-user">
                    <span class="user-name"><%= user.username %></span>
                    <form action="/logout" method="POST" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%=csrfToken%>">
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </div>
            <% } else { %>
                <a href="/login" class="nav-link">Login</a>
                <a href="/register" class="nav-link nav-btn">Sign Up</a>
            <% } %>
        </div>
    </div>
</nav>


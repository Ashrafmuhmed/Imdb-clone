<%- include('../includes/head.ejs', {
    pageTitle: 'IMDB Clone - Home',
    showNav: true,
    isLoggedIn: typeof isLoggedIn !== 'undefined' ? isLoggedIn : false,
    user: typeof user !== 'undefined' ? user : null
}) %>

<main class="home-container">
    <section class="hero-section">
        <div class="hero-content">
            <h1>Welcome to IMDB Clone</h1>
            <p class="hero-subtitle">Discover movies, TV shows, and celebrities</p>
            <div class="hero-search">
                <form action="/search" method="GET" class="hero-search-form">
                    <input type="text" name="q" placeholder="Search for movies, shows, or people..." class="hero-search-input">
                    <button type="submit" class="hero-search-btn">Search</button>
                </form>
            </div>
        </div>
    </section>

    <section class="featured-section">
        <div class="container">
            <h2 class="section-title">Browse by Category</h2>
            <div class="category-grid">
                <a href="/titles?type=movie" class="category-card">
                    <div class="category-icon">🎬</div>
                    <h3>Movies</h3>
                    <p>Explore thousands of movies</p>
                </a>
                <a href="/titles?type=tvSeries" class="category-card">
                    <div class="category-icon">📺</div>
                    <h3>TV Series</h3>
                    <p>Discover TV shows and series</p>
                </a>
                <a href="/names" class="category-card">
                    <div class="category-icon">⭐</div>
                    <h3>Celebrities</h3>
                    <p>Browse actors, directors, and more</p>
                </a>
                <a href="/titles?sort=rating" class="category-card">
                    <div class="category-icon">🏆</div>
                    <h3>Top Rated</h3>
                    <p>Highest rated titles</p>
                </a>
            </div>
        </div>
    </section>

    <!-- Top 250 Movies Section -->
    <% if (typeof topMovies !== 'undefined' && topMovies.length > 0) { %>
    <section class="materialized-view-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">🏆 Top 250 Movies</h2>
                <a href="/top-250-movies" class="view-all-link">View All Top 250 Movies →</a>
            </div>
            <div class="titles-grid">
                <% topMovies.forEach(title => { %>
                <div class="title-card">
                    <a href="/titles/<%= title.tconst %>" class="title-link">
                        <div class="title-info">
                            <div class="title-header">
                                <h3 class="title-name"><%= title.primary_title %></h3>
                                <div class="title-rating">
                                    <%= title.average_rating ? title.average_rating.toFixed(1) : 'N/A' %> ⭐
                                </div>
                            </div>
                            <p class="title-meta">
                                <%= title.start_year || 'N/A' %> •
                                <%= title.runtime_minutes || 'N/A' %> min
                            </p>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Top 250 TV Series Section -->
    <% if (typeof topSeries !== 'undefined' && topSeries.length > 0) { %>
    <section class="materialized-view-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">📺 Top 250 TV Series</h2>
                <a href="/top-250-series" class="view-all-link">View All Top 250 Series →</a>
            </div>
            <div class="titles-grid">
                <% topSeries.forEach(title => { %>
                <div class="title-card">
                    <a href="/titles/<%= title.tconst %>" class="title-link">
                        <div class="title-info">
                            <div class="title-header">
                                <h3 class="title-name"><%= title.primary_title %></h3>
                                <div class="title-rating">
                                    <%= title.average_rating ? title.average_rating.toFixed(1) : 'N/A' %> ⭐
                                </div>
                            </div>
                            <p class="title-meta">
                                <%= title.start_year || 'N/A' %> 
                            </p>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Top Episodes Section -->
    <% if (typeof topEpisodes !== 'undefined' && topEpisodes.length > 0) { %>
    <section class="materialized-view-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">⭐ Top Episodes</h2>
                <a href="/top-episodes" class="view-all-link">View All Top Episodes →</a>
            </div>
            <div class="titles-grid">
                <% topEpisodes.forEach(title => { %>
                <div class="title-card">
                    <a href="/titles/<%= title.tconst %>" class="title-link">
                        <div class="title-info">
                            <div class="title-header">
                                <h3 class="title-name"><%= title.episode_title %></h3>
                                <div class="title-rating">
                                    <%= title.average_rating ? title.average_rating.toFixed(1) : 'N/A' %> ⭐
                                </div>
                            </div>
                            <p class="title-meta">
                                <%= title.series_title || 'N/A' %> •
                                S<%= title.season_number %>E<%= title.episode_number %>
                            </p>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>
</main>

<%- include('../includes/end.ejs') %>
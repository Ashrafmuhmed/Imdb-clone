<%- include('../includes/head.ejs', {
    pageTitle: (typeof name !== 'undefined' ? name.primary_name : 'Person') + ' - IMDB Clone',
    showNav: true,
    isLoggedIn: typeof isLoggedIn !== 'undefined' ? isLoggedIn : false,
    user: typeof user !== 'undefined' ? user : null
}) %>

<main class="name-detail-container">
    <div class="container">
        <% if (typeof name !== 'undefined') { %>
        <div class="name-detail-header">
            <div class="name-detail-info">
                <h1 class="name-detail-title"><%= name.primary_name %></h1>
                
                <div class="name-stats">
                    <div class="stat-item">
                        <span class="stat-label">Born:</span>
                        <span class="stat-value"><%= name.birth_year || 'N/A' %></span>
                    </div>
                    <% if (name.death_year) { %>
                    <div class="stat-item">
                        <span class="stat-label">Died:</span>
                        <span class="stat-value"><%= name.death_year %></span>
                    </div>
                    <% } %>
                </div>

                <% if (typeof professions !== 'undefined' && professions.length > 0) { %>
                <div class="name-professions">
                    <h3>Professions</h3>
                    <div class="professions-list">
                        <% professions.forEach(prof => { %>
                            <span class="profession-tag"><%= prof %></span>
                        <% }); %>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <div class="name-detail-content">
            <% if (typeof knownFor !== 'undefined' && knownFor.length > 0) { %>
            <section class="detail-section" id="known-for">
                <h2>Known For</h2>
                <div class="titles-grid">
                    <% knownFor.forEach(title => { %>
                    <div class="title-card">
                        <a href="/titles/<%= title.tconst %>" class="title-link">
                            <div class="title-info">
                                <div class="title-header">
                                    <h3 class="title-name"><%= title.primary_title %></h3>
                                    <div class="title-rating">
                                        <% if (title.rating && title.rating.average_rating) { %>
                                            <%= title.rating.average_rating.toFixed(1) %> ⭐
                                        <% } else { %>
                                            N/A ⭐
                                        <% } %>
                                    </div>
                                </div>
                                <p class="title-meta">
                                    <%= title.runtime_minutes || 'N/A' %> min
                                </p>
                            </div>
                        </a>
                    </div>
                    <% }); %>
                </div>
                <% if (typeof hasMoreKnownFor !== 'undefined' && hasMoreKnownFor && !showAll) { %>
                    <a href="?showAll=true#known-for" class="show-all-link">Show all known for (<%= typeof allKnownFor !== 'undefined' ? allKnownFor.length : knownFor.length %>)</a>
                <% } %>
            </section>
            <% } %>

            <% if (typeof principalTitles !== 'undefined' && principalTitles.length > 0) { %>
            <section class="detail-section" id="appeared-in">
                <h2>Appeared In</h2>
                <div class="titles-grid">
                    <% principalTitles.forEach(principal => { %>
                        <% if (principal.title) { %>
                        <div class="title-card">
                            <a href="/titles/<%= principal.title.tconst %>" class="title-link">
                                <div class="title-info">
                                    <div class="title-header">
                                        <h3 class="title-name"><%= principal.title.primary_title %></h3>
                                        <div class="title-rating">
                                            <% if (principal.title.rating && principal.title.rating.average_rating) { %>
                                                <%= principal.title.rating.average_rating.toFixed(1) %> ⭐
                                            <% } else { %>
                                                N/A ⭐
                                            <% } %>
                                        </div>
                                    </div>
                                    <% if (principal.category) { %>
                                    <p class="principal-category-badge">
                                        <%= principal.category %>
                                    </p>
                                    <% } %>
                                    <% if (principal.characters) { %>
                                    <p class="principal-character-info">
                                        <%
                                            let charDisplay = principal.characters;
                                            try {
                                                if (typeof principal.characters === 'string' && principal.characters.startsWith('[')) {
                                                    const parsed = JSON.parse(principal.characters);
                                                    charDisplay = Array.isArray(parsed) ? parsed.join(', ') : principal.characters;
                                                }
                                            } catch(e) {
                                                charDisplay = principal.characters;
                                            }
                                        %>
                                        <strong>"<%= charDisplay %>"</strong>
                                    </p>
                                    <% } %>
                                    <p class="title-meta">
                                        <%= principal.title.start_year || 'N/A' %>
                                    </p>
                                </div>
                            </a>
                        </div>
                        <% } %>
                    <% }); %>
                </div>
                <% if (typeof hasMorePrincipalTitles !== 'undefined' && hasMorePrincipalTitles && !showAll) { %>
                    <a href="?showAll=true#appeared-in" class="show-all-link">Show all appearances (<%= typeof allPrincipalTitles !== 'undefined' ? allPrincipalTitles.length : principalTitles.length %>)</a>
                <% } %>
            </section>
            <% } %>

            <% if (typeof directedTitles !== 'undefined' && directedTitles.length > 0) { %>
            <section class="detail-section" id="directed">
                <h2>Directed</h2>
                <div class="titles-grid">
                    <% directedTitles.forEach(title => { %>
                    <div class="title-card">
                        <a href="/titles/<%= title.tconst %>" class="title-link">
                            <div class="title-info">
                                <div class="title-header">
                                    <h3 class="title-name"><%= title.primary_title %></h3>
                                    <div class="title-rating">
                                        <% if (title.rating && title.rating.average_rating) { %>
                                            <%= title.rating.average_rating.toFixed(1) %> ⭐
                                        <% } else { %>
                                            N/A ⭐
                                        <% } %>
                                    </div>
                                </div>
                                <p class="title-meta">
                                    <%= title.start_year || 'N/A' %>
                                </p>
                            </div>
                        </a>
                    </div>
                    <% }); %>
                </div>
                <% if (typeof hasMoreDirectedTitles !== 'undefined' && hasMoreDirectedTitles && !showAll) { %>
                    <a href="?showAll=true#directed" class="show-all-link">Show all directed titles (<%= typeof allDirectedTitles !== 'undefined' ? allDirectedTitles.length : directedTitles.length %>)</a>
                <% } %>
            </section>
            <% } %>

            <% if (typeof writtenTitles !== 'undefined' && writtenTitles.length > 0) { %>
            <section class="detail-section" id="written">
                <h2>Written</h2>
                <div class="titles-grid">
                    <% writtenTitles.forEach(title => { %>
                    <div class="title-card">
                        <a href="/titles/<%= title.tconst %>" class="title-link">
                            <div class="title-info">
                                <div class="title-header">
                                    <h3 class="title-name"><%= title.primary_title %></h3>
                                    <div class="title-rating">
                                        <% if (title.rating && title.rating.average_rating) { %>
                                            <%= title.rating.average_rating.toFixed(1) %> ⭐
                                        <% } else { %>
                                            N/A ⭐
                                        <% } %>
                                    </div>
                                </div>
                                <p class="title-meta">
                                    <%= title.start_year || 'N/A' %>
                                </p>
                            </div>
                        </a>
                    </div>
                    <% }); %>
                </div>
                <% if (typeof hasMoreWrittenTitles !== 'undefined' && hasMoreWrittenTitles && !showAll) { %>
                    <a href="?showAll=true#written" class="show-all-link">Show all written titles (<%= typeof allWrittenTitles !== 'undefined' ? allWrittenTitles.length : writtenTitles.length %>)</a>
                <% } %>
            </section>
            <% } %>
        </div>
        <% } else { %>
            <div class="error-message">
                <h2>Person not found</h2>
                <p>The person you're looking for doesn't exist.</p>
                <a href="/names" class="back-link">Browse People</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('../includes/end.ejs') %>


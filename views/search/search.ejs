<%- include('../includes/head.ejs', {
    pageTitle: 'Search Results - IMDB Clone',
    showNav: true,
    isLoggedIn: typeof isLoggedIn !== 'undefined' ? isLoggedIn : false,
    user: typeof user !== 'undefined' ? user : null,
    query: typeof query !== 'undefined' ? query : ''
}) %>

<main class="search-results-container">
    <div class="container">
        <div class="search-header">
            <h1>Search Results</h1>
            <p class="search-query">Results for: "<%= typeof query !== 'undefined' ? query : '' %>"</p>
        </div>

        <% if (typeof results !== 'undefined' && results.length > 0) { %>
        <section class="search-section">
            <h2 class="section-title">Results (<%= results.length %>)</h2>
            <div class="mixed-results-grid">
                <% results.forEach(result => { %>
                    <% if (result.type === 'title') { %>
                    <div class="title-card">
                        <a href="/titles/<%= result.tconst %>" class="title-link">
                            <div class="title-info">
                                <div class="title-header">
                                    <h3 class="title-name"><%= result.primaryTitle %></h3>
                                    <div class="title-rating">
                                        <% if (result.averageRating && result.averageRating > 0) { %>
                                            <%= result.averageRating.toFixed(1) %> ⭐
                                        <% } else { %>
                                            N/A ⭐
                                        <% } %>
                                    </div>
                                </div>
                                <p class="title-meta">
                                    <%= result.startYear || 'N/A' %><% if (result.endYear) { %> - <%= result.endYear %><% } %> • 
                                    <%= result.runtimeMinutes || 'N/A' %> min • 
                                    <%= result.title_type || 'N/A' %>
                                </p>
                                <% if (result.genres && result.genres.length > 0) { %>
                                    <p class="title-genres">
                                        <% result.genres.forEach((genre, index) => { %>
                                            <%= genre.name %><% if (index < result.genres.length - 1) { %>, <% } %>
                                        <% }); %>
                                    </p>
                                <% } %>
                            </div>
                        </a>
                    </div>
                    <% } else if (result.type === 'name') { %>
                    <div class="name-card">
                        <a href="/names/<%= result.nconst %>" class="name-link">
                            <div class="name-info">
                                <h3 class="name-title"><%= result.name %></h3>
                                <p class="name-meta">
                                    <% if (result.birthYear) { %>Born: <%= result.birthYear %><% } %><% if (result.deathYear) { %> • Died: <%= result.deathYear %><% } %>
                                </p>
                            </div>
                        </a>
                    </div>
                    <% } %>
                <% }); %>
            </div>
        </section>
        <% } %>

        <% if ((typeof results === 'undefined' || results.length === 0)) { %>
        <div class="no-results">
            <p>No results found for "<%= typeof query !== 'undefined' ? query : '' %>"</p>
            <p>Try searching with different keywords.</p>
        </div>
        <% } %>

        <% if (typeof pagination !== 'undefined' && (pagination.hasNext || pagination.hasPrev)) { %>
        <div class="pagination">
            <% if (pagination.hasPrev) { %>
                <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= pagination.prevPage %>" class="page-btn">Previous</a>
            <% } %>
            <span class="page-info">Page <%= pagination.page %></span>
            <% if (pagination.hasNext) { %>
                <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= pagination.nextPage %>" class="page-btn">Next</a>
            <% } %>
        </div>
        <% } %>
    </div>
</main>

<%- include('../includes/end.ejs') %>
